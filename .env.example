# Copy to .env and fill in your key
OPENAI_API_KEY=sk-...

# Optional: override the LLM (any LiteLLM provider works: openai/*, anthropic/*, gemini/*, ollama/*)
# LLM_PROVIDER=openai/gpt-4o-mini

# Optional: residential/rotating proxy if you hit blocks at volume
# PROXY_URL=http://user:pass@host:port
